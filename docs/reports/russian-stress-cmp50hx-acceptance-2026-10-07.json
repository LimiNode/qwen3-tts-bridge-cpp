  "cases": [
    {"id": "zamok_a", "text": "Ста́рый за́мок стоит на горе́.", "first_pcm_ms": 191.99, "audio_bytes": 103680, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "zamok_o", "text": "Новый замо́к закрывает дверь.", "first_pcm_ms": 196.57, "audio_bytes": 80640, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "muka_a", "text": "Эта му́ка нужна для теста.", "first_pcm_ms": 195.84, "audio_bytes": 88320, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "muka_o", "text": "Его мука́ была сильной.", "first_pcm_ms": 188.91, "audio_bytes": 111360, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "atlas_a", "text": "На столе лежит а́тлас.", "first_pcm_ms": 188.75, "audio_bytes": 96000, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "atlas_o", "text": "Рядом новый атла́с тканей.", "first_pcm_ms": 187.42, "audio_bytes": 126720, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "numbers", "text": "В две тысячи двадцать шестом году робот проверит сто двадцать три команды и сорок пять голосов.", "first_pcm_ms": 188.82, "audio_bytes": 334080, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "abbr", "text": "Система ЦПУ и ОЗУ готова к запуску, версия три точка один.", "first_pcm_ms": 188.60, "audio_bytes": 234240, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "plain_short", "text": "Сегодня тёплый роботизированный голос говорит спокойно.", "first_pcm_ms": 179.47, "audio_bytes": 172800, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "plain_medium", "text": "Сегодня тёплый роботизированный голос проверяет новую русскую фразу без явных знаков ударения.", "first_pcm_ms": 188.66, "audio_bytes": 326400, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "long_ops", "text": "Сначала проверь питание, затем связь и датчики, после этого запусти диагностику и сообщи результат оператору.", "first_pcm_ms": 194.29, "audio_bytes": 449280, "execution_outcome": "natural_eos", "starvation_detected": false},
    {"id": "stress_sentence", "text": "Сего́дня тёплый голос проверяет за́мок на горе́, а на двери слома́лся замо́к.", "first_pcm_ms": 180.14, "audio_bytes": 264960, "execution_outcome": "natural_eos", "starvation_detected": false}
