-            use_cache=True,
-            output_hidden_states=True,
-            return_dict=True,
-            trailing_text_hidden=trailing_text_hiddens,
-            tts_pad_embed=tts_pad_embed,
-            generation_step=None,
-            past_hidden=None,
-            past_key_values=None,
+        out, backend_profile = _run_talker_prefill(
+            talker,
