{"appropriate_length": true, "candidate_sha256": "d5389e7718ba1b305bf4516e5683bc34120118d73325a6a104b7171c7db4aef2", "category_fidelity": true, "code_switch_naturalness": null, "final_text": "The video feed is stable, but reloading the gameplay scene activates a hidden audio channel and doubles my voice. I will mute that source, make a short local recording, and test one scene change before restoring alerts. You can stay connected; my mic may cut out briefly.", "final_text_sha256": "57b675179f8d71da312a99141cb9fa5d736ebdd86001a11cc220969deb59eb2f", "generic_ai_phrasing": false, "grammar": true, "language_class": "en", "likely_real_usage": true, "metadata_only_replacement": false, "naturalness": true, "notes": "Human review: PASS.", "record_id": "v4-b07-029", "repair_authoring_sha256": "192361a1dd3983fca5ae08eac19c97e43036af05a629c58324be2f1cd4624e70", "repair_reasons": ["naturalness", "likely_real_usage"], "review_scope": "post_repair_corpus_v4_targeted_rereview", "review_status": "completed_human_review", "reviewer_id": "anonymous", "scene_context_fidelity": true, "semantic_repetition_acceptable": true, "speech_intent_fidelity": true, "target": {"category": "stream_event", "scene_context": "technical_stream", "speech_intent": "moderation_or_technical"}, "targeted_rereview_schema_version": 1}
{"appropriate_length": true, "candidate_sha256": "d5389e7718ba1b305bf4516e5683bc34120118d73325a6a104b7171c7db4aef2", "category_fidelity": true, "code_switch_naturalness": true, "final_text": "Перед одним забегом кнопки внезапно вернулись к старой раскладке. Сначала я решил, что раскладку сбросил patch, но Steam Input загрузил чужой профиль из облака. Теперь перед стартом проверяю раскладку контроллера и сохраняю свою схему локально, чтобы не переназначать кнопки прямо в эфире.", "final_text_sha256": "e21abd158d4847376bffd7b7a0a9aa495768478dfe1d4e49e565576b8b98ea39", "generic_ai_phrasing": false, "grammar": true, "language_class": "mixed", "likely_real_usage": true, "metadata_only_replacement": false, "naturalness": true, "notes": "Human review: PASS.", "record_id": "v4-b07-168", "repair_authoring_sha256": "192361a1dd3983fca5ae08eac19c97e43036af05a629c58324be2f1cd4624e70", "repair_reasons": ["naturalness", "code_switch_naturalness"], "review_scope": "post_repair_corpus_v4_targeted_rereview", "review_status": "completed_human_review", "reviewer_id": "anonymous", "scene_context_fidelity": true, "semantic_repetition_acceptable": true, "speech_intent_fidelity": true, "target": {"category": "live_chat", "scene_context": "just_chatting_stream", "speech_intent": "story_anecdote"}, "targeted_rereview_schema_version": 1}
{"appropriate_length": true, "candidate_sha256": "d5389e7718ba1b305bf4516e5683bc34120118d73325a6a104b7171c7db4aef2", "category_fidelity": true, "code_switch_naturalness": null, "final_text": "Frame-by-frame capture shows strong airlock tension but weak route signaling. The game never explains that thrusters near the relay seal both doors, while the maintenance arm keeps the return route open.", "final_text_sha256": "a11335a0cc89e104d94d5d4fd5b48c75ac2b83b55436f7693b75490dbad3d321", "generic_ai_phrasing": false, "grammar": true, "language_class": "en", "likely_real_usage": true, "metadata_only_replacement": false, "naturalness": false, "notes": "Human review: frame-by-frame capture cannot idiomatically show ?strong airlock tension?.", "record_id": "v4-b08-096", "repair_authoring_sha256": "192361a1dd3983fca5ae08eac19c97e43036af05a629c58324be2f1cd4624e70", "repair_reasons": ["naturalness"], "review_scope": "post_repair_corpus_v4_targeted_rereview", "review_status": "completed_human_review", "reviewer_id": "anonymous", "scene_context_fidelity": true, "semantic_repetition_acceptable": true, "speech_intent_fidelity": true, "target": {"category": "game_review", "scene_context": "technical_stream", "speech_intent": "opinion_review"}, "targeted_rereview_schema_version": 1}
