@@ -29,5 +29,48 @@ from .utils import suppress_flash_attn_warning
 logger = logging.getLogger(__name__)
 
 
+def _use_codec_right_padded_compile() -> bool:
+    """Return whether the opt-in compiled right-padded codec path is active."""
+
+    return os.environ.get("QTB_FASTER_CODEC_RIGHT_PADDED_COMPILE") == "1"
+
+
+def _codec_right_padded_compile_mode() -> str:
+    """Return the supported torch.compile mode for the decoder experiment."""
+
+    mode = os.environ.get(
+        "QTB_FASTER_CODEC_RIGHT_PADDED_COMPILE_MODE", "reduce-overhead"
+    )
+    if mode not in {"default", "reduce-overhead", "max-autotune"}:
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_RIGHT_PADDED_COMPILE_MODE must be default, "
+            "reduce-overhead, or max-autotune"
+        )
+    return mode
+
+
+def _enable_right_padded_decoder_compile(base_model: Any) -> None:
+    """Compile only the fixed-shape codec decoder for the opt-in experiment."""
+
+    if not _use_codec_right_padded_compile():
+        return
+    if not _use_codec_right_padded_decode():
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_RIGHT_PADDED_COMPILE=1 requires "
+            "QTB_FASTER_CODEC_RIGHT_PADDED_DECODE=1"
+        )
+    speech_tokenizer = getattr(getattr(base_model, "model", None), "speech_tokenizer", None)
+    decoder = getattr(getattr(speech_tokenizer, "model", None), "decoder", None)
+    compile_for_streaming = getattr(decoder, "compile_for_streaming", None)
+    if not callable(compile_for_streaming):
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_RIGHT_PADDED_COMPILE=1 requires a compatible "
+            "12 Hz decoder with compile_for_streaming"
+        )
+    mode = _codec_right_padded_compile_mode()
+    logger.info("Compiling fixed-shape right-padded codec decoder with mode=%s", mode)
+    compile_for_streaming(mode=mode)
+
+
 def _use_codec_right_padded_decode() -> bool:
