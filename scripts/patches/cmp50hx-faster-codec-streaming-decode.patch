+def _use_codec_streaming_decode() -> bool:
+    """Return whether the opt-in fixed-shape codec experiment is active."""
+
+    return os.environ.get("QTB_FASTER_CODEC_STREAMING_DECODE") == "1"
+
+
+def _codec_streaming_decode_window_frames() -> int:
+    """Return the fixed codec window size requested by the experiment."""
+
+    raw_value = os.environ.get("QTB_FASTER_CODEC_STREAMING_DECODE_WINDOW_FRAMES", "80")
+    try:
+        value = int(raw_value)
+    except ValueError as exc:
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_STREAMING_DECODE_WINDOW_FRAMES must be an integer"
+        ) from exc
+    if value <= 0:
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_STREAMING_DECODE_WINDOW_FRAMES must be positive"
+        )
+    return value
+
+
+def _decode_streaming_window(
+    speech_tokenizer: Any,
+    audio_codes: torch.Tensor,
+    decode_window_frames: int,
+) -> tuple[list, int]:
+    """Decode one fixed-shape codec window or fail closed when unavailable."""
+
+    decode_streaming = getattr(speech_tokenizer, "decode_streaming", None)
+    if not callable(decode_streaming):
+        raise RuntimeError(
+            "QTB_FASTER_CODEC_STREAMING_DECODE=1 requires "
+            "speech_tokenizer.decode_streaming"
+        )
+    if audio_codes.shape[0] > decode_window_frames:
+        raise RuntimeError(
+            "fixed codec decode window is smaller than its input: "
+            f"{audio_codes.shape[0]} > {decode_window_frames}"
+        )
+    return decode_streaming(
+        audio_codes,
+        use_optimized=True,
+        pad_to_size=decode_window_frames,
+    )
+
