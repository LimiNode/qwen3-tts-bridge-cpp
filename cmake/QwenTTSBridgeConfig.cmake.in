@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

# The bridge's public target only exposes the C++ standard library.  Its
# process and JSON implementation dependencies are private to the build and
# are intentionally not part of the installed public API.
include("${CMAKE_CURRENT_LIST_DIR}/QwenTTSBridgeTargets.cmake")

check_required_components(QwenTTSBridge)
