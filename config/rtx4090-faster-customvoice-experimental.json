{
  "profile_schema_version": 1,
  "name": "rtx4090-faster-customvoice-experimental",
  "description": "Measured experimental profile for the Qwen3-TTS 12Hz 0.6B CustomVoice model. It is consumed by scripts/start-rtx4090-faster-customvoice.ps1, not directly by the worker.",
  "model_path": "models/Qwen3-TTS-12Hz-0.6B-CustomVoice",
  "runtime_backend": "faster",
  "device": "cuda",
  "dtype": "bfloat16",
  "attn_implementation": "sdpa",
  "emit_every_frames": 8,
  "decode_window_frames": 80,
  "prefill_backend": "compile_reduce_overhead",
  "prefill_compile_compat_mode": "strict_bf16_sdpa_v1",
  "prefill_compile_lengths": [32, 29, 35, 34, 33, 30],
  "prefill_compile_on_miss": false,
  "prefill_unknown_shape_policy": "eager",
  "prefill_compile_policy": "exact_allowlist",
  "prefill_allowlist_warmup_manifest": "docs/benchmark-artifacts/rtx4090-2026-07-22/prefill-length-histogram-customvoice-500.json",
  "prefill_allowlist_warmup_repeats": 3,
  "prefill_allowlist_max_entries": 6,
  "prefill_allowlist_max_abs_threshold": 0.0,
  "prefill_require_precompiled": true,
  "prefill_first_chunk_warmup": true,
  "prefill_first_chunk_warmup_length": 32,
  "collect_generation_trace": true,
  "profile_prefill": true
}
