if(NOT DEFINED QWEN_TTS_BRIDGE_SOURCE_ROOT)
    message(FATAL_ERROR "QWEN_TTS_BRIDGE_SOURCE_ROOT is required")
endif()

file(GLOB_RECURSE _sources LIST_DIRECTORIES false
    "${QWEN_TTS_BRIDGE_SOURCE_ROOT}/src/qwen_tts_bridge/*.cpp")

foreach(_source IN LISTS _sources)
    file(RELATIVE_PATH _relative "${QWEN_TTS_BRIDGE_SOURCE_ROOT}" "${_source}")
    set(_expected "")
    if(_relative MATCHES "^src/qwen_tts_bridge/audio/")
        set(_expected "qwen_tts_bridge/audio.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/protocol/control/")
        set(_expected "qwen_tts_bridge/protocol/control.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/protocol/framing/")
        set(_expected "qwen_tts_bridge/protocol/framing.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/transport/stdio/")
        set(_expected "qwen_tts_bridge/transport/stdio.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/session/")
        set(_expected "qwen_tts_bridge/session.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/client/")
        set(_expected "qwen_tts_bridge/client.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/text/")
        set(_expected "qwen_tts_bridge/text.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/native/")
        set(_expected "qwen_tts_bridge/native.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/integration/speech_animation/")
        set(_expected "qwen_tts_bridge/integration/speech_animation.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/playback/playback_receipt\.cpp$")
        set(_expected "qwen_tts_bridge/playback.hpp")
    elseif(_relative MATCHES "^src/qwen_tts_bridge/playback/(winmm_playback|playback_interruption_diagnostics)\.cpp$")
        set(_expected "qwen_tts_bridge/playback/winmm.hpp")
    else()
        message(FATAL_ERROR "No owning umbrella mapping for ${_relative}")
    endif()

    file(STRINGS "${_source}" _lines)
    set(_first_include "")
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _trimmed)
        if(_trimmed MATCHES "^#include[ \t]+")
            set(_first_include "${_trimmed}")
            break()
        endif()
    endforeach()
    if(_first_include STREQUAL "")
        message(FATAL_ERROR "${_relative} has no include directive")
    endif()
    string(FIND "${_first_include}" "${_expected}" _expected_position)
    if(_expected_position LESS 0)
        message(FATAL_ERROR
            "${_relative} must start with owning umbrella ${_expected}; got ${_first_include}")
    endif()
endforeach()
