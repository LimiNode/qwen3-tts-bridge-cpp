# Editor-only context for implementation files compiled through domain TUs.
# The real CMake commands compile the wrappers, without forced includes or PCH.
If:
  PathMatch: src/qwen_tts_bridge/audio/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/audio.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/client/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/client.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/protocol/control/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/protocol/control.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/protocol/framing/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/protocol/framing.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/session/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/session.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/transport/stdio/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/transport/stdio.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/text/.*\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/text.hpp]
---
If:
  PathMatch: src/qwen_tts_bridge/playback/playback_interruption_diagnostics\.cpp
CompileFlags:
  Add: [-include, qwen_tts_bridge/playback/winmm.hpp]
